# Optional settings for public-market paper mode. Load in your shell before starting.
export PAPER_DB=paper.sqlite3
export PAPER_CASH=10000
export PAPER_DAILY_LOSS=0.01
# export PAPER_WEBHOOK_URL=https://your-webhook.example/path

# Compose strategy: keltner-1d, ema-1d, donchian-1d, or observe.
PAPER_STRATEGY=ema-1d

# Optional Turkish paper notifications. Both values must be defined.
# export TELEGRAM_BOT_TOKEN=
# export TELEGRAM_CHAT_ID=
